  "standard_benchmarks": [
    {
      "name": "Ideal gas partition function",
      "reference": "Z_N = (V/N!)(2πmkT/h²)^{3/2}",
      "tolerance": 1e-4
    },
    {
      "name": "Ising model critical temperature (2D)",
      "reference": "T_c = 2J/(k_B ln(1+√2))",
      "tolerance": 1e-5
    },
    {
      "name": "Maxwell-Boltzmann distribution normalization",
      "reference": "∫f(v)dv = 1",
      "tolerance": 1e-6
    }
  ],
  "convention_sensitive": ["natural_units", "boltzmann_units", "matsubara_convention"],
  "scripts_available": ["scripts/dimensional_check.py", "scripts/spot_check.py", "scripts/convergence_check.py", "scripts/limiting_case_check.py"]
